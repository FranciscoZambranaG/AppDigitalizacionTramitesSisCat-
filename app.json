{
  "expo": {
    "name": "DigiD",
    "slug": "AppTramitesSisCat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "digid",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.catastrocbba.digid",
      "infoPlist": {
        "NSCameraUsageDescription": "La aplicacion usa la camara para escanear y fotografiar documentos de tramites.",
        "NSPhotoLibraryUsageDescription": "La aplicacion accede a tus fotos para adjuntar documentos a un tramite.",
        "NSFaceIDUsageDescription": "Se usa Face ID para el acceso biometrico a la aplicacion."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3f008c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.catastrocbba.digid",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "URL_BASE": "https://bkdgd.catastrocbba.com",
      "PADDLE_OCR_URL": "https://ocr.catastrocbba.com/ocr/",
      "ALLOWED_FILE_TYPES": "application/pdf,image/jpeg,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip,application/x-rar-compressed,application/octet-stream",
      "KEYCLOAK_BASE_URL": "https://auth.catastrocbba.com",
      "KEYCLOAK_REALM": "master",
      "KEYCLOAK_CLIENT_ID": "admin-cli",
      "KEYCLOAK_CLIENT_SECRET": "",
      "KEYCLOAK_SCOPE": "openid profile"
    }
  }
}
