# Copiar a ".env". Nunca commitear el .env real.

# --- Base de datos -----------------------------------------------------------
# En desarrollo: SQLite, no hace falta instalar nada.
DATABASE_URL=sqlite:///./resoluciones.db
# Para integrar con la BD del ERP (schema propio "resoluciones"):
# DATABASE_URL=postgresql://usuario:clave@host:5432/erp

# --- Keycloak (MISMO realm/cliente que la app movil y el proyecto-erp) ------
KEYCLOAK_URL=https://auth.catastrocbba.com
KEYCLOAK_REALM=alcaldia-idec
KEYCLOAK_CLIENT_ID=app-idec
# El cliente app-idec es "confidential" -> necesita secret para el login ROPC.
# Es el mismo valor que EXPO_PUBLIC_KEYCLOAK_CLIENT_SECRET en la app movil.
# NO se expone al navegador: solo lo usa este backend contra Keycloak.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TIMEOUT_SECONDS=20

# --- CORS ------------------------------------------------------------------
# Origen del frontend web (Vite dev server). Coma-separado si hay varios.
FRONTEND_ORIGIN=http://localhost:5173

# --- Servidor ------------------------------------------------------------------
PORT=8080
