# Copiar a ".env"

# Backend del modulo Resoluciones (resoluciones/backend/, "python -m app.main").
VITE_API_URL=http://localhost:8080

# Servicio OCR de GAMC (PaddleOCR con cola). El navegador le pega directo, igual
# que el modulo geoextraccion del proyecto-erp. Sin "/" al final.
VITE_OCR_API_URL=https://ocr.catastrocbba.com

# Umbral de confianza: celdas por debajo de esto se marcan en rojo para revisar.
VITE_OCR_THRESHOLD=0.85
